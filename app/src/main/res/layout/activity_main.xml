        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>

                <!-- LATEST NEWS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:text="Latest News"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/newsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading latest news..."
                        android:textColor="#8A98AB"
                        android:textSize="13sp"
                        android:padding="10dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/moreNewsButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="More News  →"
                    android:textColor="#E91E4D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#142033"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- SPORT NEWS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Sport News"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/sportNewsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading sport news..."
                        android:textColor="#8A98AB"
                        android:textSize="13sp"
                        android:padding="10dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/moreSportNewsButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="More Sport News  →"
                    android:textColor="#E91E4D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#142033"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>


        <!-- WEBVIEW -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />


        <!-- SETTINGS -->

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#0B1220"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Customize your Deeprows Browser"
                    android:textColor="#8795AA"
                    android:textSize="12sp" />


                <!-- DATA SAVING -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="8dp"
                    android:background="#162235">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Data Saving"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Reduce images and page data"
                            android:textColor="#8795AA"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/dataSavingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E91E4D" />

                </LinearLayout>


                <!-- AD BLOCKING -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="8dp"
                    android:background="#162235">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ad Blocking"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Block common advertising requests"
                            android:textColor="#8795AA"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/adBlockingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#E91E4D" />

                </LinearLayout>


                <!-- HISTORY -->

                <TextView
                    android:id="@+id/historyButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="🕘   History"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#162235"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- BOOKMARKS -->

                <TextView
                    android:id="@+id/bookmarksButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="★   Bookmarks"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#162235"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- OFFLINE PAGES -->

                <TextView
                    android:id="@+id/offlinePagesButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="↓   Offline Pages"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#162235"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- CLEAR CACHE -->

                <TextView
                    android:id="@+id/clearCacheButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="♻   Clear Cache"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#162235"
                    android:clickable="true"
                    android:focusable="true" />


                <TextView
                    android:id="@+id/settingsBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="← Back to Browser"
                    android:textColor="#E91E4D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="#142033"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>


    <!-- SLIM BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#101A2A">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#8795AA"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:tint="#8795AA"
            android:contentDescription="Forward" />

       <ImageButton
    android:id="@+id/refreshButton"
    android:layout_width="0dp"
    android:layout_height="46dp"
    android:layout_weight="1"
    android:background="@android:color/transparent"
    android:src="@android:drawable/ic_popup_sync"
    android:tint="#8795AA"
    android:contentDescription="Refresh" />

<ImageButton
    android:id="@+id/menuButton"
    android:layout_width="0dp"
    android:layout_height="46dp"
    android:layout_weight="1"
    android:background="@android:color/transparent"
    android:src="@android:drawable/ic_menu_manage"
    android:tint="#8795AA"
    android:contentDescription="Settings" />

<ImageButton
    android:id="@+id/homeButton"
    android:layout_width="0dp"
    android:layout_height="46dp"
    android:layout_weight="1"
    android:background="@android:color/transparent"
    android:src="@android:drawable/ic_menu_view"
    android:tint="#E91E4D"
    android:contentDescription="Home" />

    </LinearLayout>

</LinearLayout>
