            <TextView android:id="@+id/siteStudyportals" android:layout_width="150dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Studyportals" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
