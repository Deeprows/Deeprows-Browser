<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090D"
    android:fitsSystemWindows="true">

    <!-- ========================================================= -->
    <!-- TOP HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:background="#0B0E14">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="D"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="#FF1744" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="DEEPR0WSS"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFF"
            android:contentDescription="Menu" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SEARCH -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#0B0E14">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#171C25"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#8D96A5"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search or enter website"
                android:textColor="#FFFFFF"
                android:textColorHint="#737C8C"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/goButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="#FF1744"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:contentDescription="Go" />

    </LinearLayout>


    <!-- LOADING BAR -->

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />


    <!-- ========================================================= -->
    <!-- MAIN AREA -->
    <!-- ========================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================================================== -->
        <!-- HOME PAGE -->
        <!-- ===================================================== -->

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="24dp">


                <!-- ================================================= -->
                <!-- QUICK SITES -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Sites"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swipe →"
                        android:textColor="#737C8C"
                        android:textSize="11sp" />

                </LinearLayout>


                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <!-- FACEBOOK -->

                        <LinearLayout
                            android:id="@+id/siteFacebook"
                            android:layout_width="92dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#11161F"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:text="f"
                                android:textColor="#FFFFFF"
                                android:textSize="27sp"
                                android:textStyle="bold"
                                android:background="#1877F2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Facebook"
                                android:textColor="#D9DEE7"
                                android:textSize="11sp" />

                        </LinearLayout>


                        <!-- INSTAGRAM -->

                        <LinearLayout
                            android:id="@+id/siteInstagram"
                            android:layout_width="92dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#11161F"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:text="◎"
                                android:textColor="#FFFFFF"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:background="#D62976" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Instagram"
                                android:textColor="#D9DEE7"
                                android:textSize="11sp" />

                        </LinearLayout>


                        <!-- SPORTYBET -->

                        <LinearLayout
                            android:id="@+id/siteSportyBet"
                            android:layout_width="92dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#11161F"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:text="S"
                                android:textColor="#FFFFFF"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:background="#16A34A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="SportyBet"
                                android:textColor="#D9DEE7"
                                android:textSize="11sp" />

                        </LinearLayout>


                        <!-- BET9JA -->

                        <LinearLayout
                            android:id="@+id/siteBet9ja"
                            android:layout_width="92dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#11161F"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#FFFFFF"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:background="#F59E0B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Bet9ja"
                                android:textColor="#D9DEE7"
                                android:textSize="11sp" />

                        </LinearLayout>


                        <!-- DEEPROWSS -->

                        <LinearLayout
                            android:id="@+id/siteDeeprowss"
                            android:layout_width="92dp"
                            android:layout_height="100dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#11161F"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#FFFFFF"
                                android:textSize="25sp"
                                android:textStyle="bold"
                                android:background="#FF1744" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Deeprowss"
                                android:textColor="#D9DEE7"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>


                <!-- ================================================= -->
                <!-- DEEPROWSS PROMO -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/deeprowssPromo"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="#171C25"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DEEPR0WSS"
                        android:textColor="#FF1744"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Live Football • Movies • Highlights"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap to visit deeprowss.com  →"
                        android:textColor="#8D96A5"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- NEWS HEADER -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Latest News"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/newsRefreshLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        android:textColor="#FF1744"
                        android:textSize="12sp" />

                </LinearLayout>


                <!-- NEWS -->

                <LinearLayout
                    android:id="@+id/newsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/newsLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading latest news..."
                        android:textColor="#8D96A5"
                        android:textSize="14sp"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- WEBVIEW -->
        <!-- ===================================================== -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0B0E14"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#8D96A5"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:tint="#8D96A5"
            android:contentDescription="Forward" />

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#8D96A5"
            android:contentDescription="Refresh" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#FF1744"
            android:contentDescription="Home" />

    </LinearLayout>

</LinearLayout>
