<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="#101A2A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="D"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:background="#E91E4D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="DEEPR0WSS"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#B8C2D3"
            android:contentDescription="Menu" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- SEARCH -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#101A2A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#192536"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#8795AA"
                android:textSize="21sp" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search or enter website"
                android:textColor="#FFFFFF"
                android:textColorHint="#7E8A9D"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/goButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="#E91E4D"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:contentDescription="Go" />

    </LinearLayout>


    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />


    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="15dp"
                android:paddingBottom="18dp">


                <!-- ================================================= -->
                <!-- QUICK SITES -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Sites"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swipe →"
                        android:textColor="#77869B"
                        android:textSize="10sp" />

                </LinearLayout>


                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <!-- FACEBOOK -->

                        <LinearLayout
                            android:id="@+id/siteFacebook"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="f"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:background="#1877F2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Facebook"
                                android:textColor="#D6DEEA"
                                android:textSize="10sp" />

                        </LinearLayout>


                        <!-- INSTAGRAM -->

                        <LinearLayout
                            android:id="@+id/siteInstagram"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="◎"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:background="#D62976" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Instagram"
                                android:textColor="#D6DEEA"
                                android:textSize="10sp" />

                        </LinearLayout>


                        <!-- JOBS -->

                        <LinearLayout
                            android:id="@+id/siteJobs"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="J"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="#2563EB" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Jobs"
                                android:textColor="#D6DEEA"
                                android:textSize="10sp" />

                        </LinearLayout>


                        <!-- SCHOLARSHIPS -->

                        <LinearLayout
                            android:id="@+id/siteScholarships"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="S"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="#7C3AED" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Scholarships"
                                android:textColor="#D6DEEA"
                                android:textSize="9sp" />

                        </LinearLayout>


                        <!-- X -->

                        <LinearLayout
                            android:id="@+id/siteX"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="X"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:background="#000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="X"
                                android:textColor="#D6DEEA"
                                android:textSize="10sp" />

                        </LinearLayout>


                        <!-- DEEPROWSS -->

                        <LinearLayout
                            android:id="@+id/siteDeeprowss"
                            android:layout_width="84dp"
                            android:layout_height="88dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#162235"
                            android:padding="7dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="#E91E4D" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Deeprowss"
                                android:textColor="#D6DEEA"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>


                <!-- ================================================= -->
                <!-- DEEPROWSS PROMO -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/deeprowssPromo"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="17dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="#182638"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DEEPR0WSS"
                        android:textColor="#E91E4D"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Live Football • Movies • Highlights"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Visit deeprowss.com  →"
                        android:textColor="#8EA0B7"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- LATEST NEWS HEADER -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Latest News"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- LATEST NEWS -->

                <LinearLayout
                    android:id="@+id/newsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/newsLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading latest news..."
                        android:textColor="#8A98AB"
                        android:textSize="13sp"
                        android:padding="10dp" />

                </LinearLayout>


                <!-- MORE NEWS -->

                <TextView
                    android:id="@+id/moreNewsButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="More News  →"
                    android:textColor="#E91E4D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#142033"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- ================================================= -->
                <!-- SPORT NEWS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Sport News"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/sportNewsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sportNewsLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading sport news..."
                        android:textColor="#8A98AB"
                        android:textSize="13sp"
                        android:padding="10dp" />

                </LinearLayout>


                <!-- MORE SPORT NEWS -->

                <TextView
                    android:id="@+id/moreSportNewsButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="More Sport News  →"
                    android:textColor="#E91E4D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#142033"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>


        <!-- WEBVIEW -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>


    <!-- ========================================================= -->
    <!-- SLIM BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#101A2A">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#8795AA"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:tint="#8795AA"
            android:contentDescription="Forward" />

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#8795AA"
            android:contentDescription="Refresh" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#E91E4D"
            android:contentDescription="Home" />

    </LinearLayout>

</LinearLayout>
