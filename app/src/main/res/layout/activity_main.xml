<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090D"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:background="#10141B">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEEPROWSS"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFF"
            android:contentDescription="Menu" />

    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#10141B">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#1B2029"
            android:hint="Search or enter website"
            android:textColor="#FFFFFF"
            android:textColorHint="#8D96A5"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:paddingStart="15dp"
            android:paddingEnd="15dp" />

        <ImageButton
            android:id="@+id/goButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FF1744"
            android:contentDescription="Go" />

    </LinearLayout>

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <!-- MAIN AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->
        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="24dp">

                <!-- QUICK SITES TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QUICK SITES"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- QUICK SITES -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FACEBOOK -->
                        <LinearLayout
                            android:id="@+id/siteFacebook"
                            android:layout_width="82dp"
                            android:layout_height="92dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#151A22"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="f"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:background="#1877F2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Facebook"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                        <!-- INSTAGRAM -->
                        <LinearLayout
                            android:id="@+id/siteInstagram"
                            android:layout_width="82dp"
                            android:layout_height="92dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#151A22"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="◎"
                                android:textColor="#FFFFFF"
                                android:textSize="27sp"
                                android:textStyle="bold"
                                android:background="#D62976" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Instagram"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                        <!-- SPORTYBET -->
                        <LinearLayout
                            android:id="@+id/siteSportyBet"
                            android:layout_width="82dp"
                            android:layout_height="92dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#151A22"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="S"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:background="#16A34A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SportyBet"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                        <!-- BET9JA -->
                        <LinearLayout
                            android:id="@+id/siteBet9ja"
                            android:layout_width="82dp"
                            android:layout_height="92dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#151A22"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:background="#F59E0B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bet9ja"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                        <!-- DEEPROWSS -->
                        <LinearLayout
                            android:id="@+id/siteDeeprowss"
                            android:layout_width="82dp"
                            android:layout_height="92dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#151A22"
                            android:padding="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:background="#FF1744" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deeprowss"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- WELCOME CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginTop="20dp"
                    android:background="#10141B">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Deeprowss"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Browse the web faster."
                        android:textColor="#8D96A5"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <!-- LATEST NEWS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LATEST NEWS"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/newsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/newsLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading latest news..."
                        android:textColor="#8D96A5"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- WEBVIEW -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#10141B"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/forwardButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF"
            android:contentDescription="Forward" />

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFFFFF"
            android:contentDescription="Refresh" />

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#FF1744"
            android:contentDescription="Home" />

    </LinearLayout>

</LinearLayout>
