<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220"
    android:fitsSystemWindows="true">

    <!-- SEARCH -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#101A2A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#192536"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#8795AA"
                android:textSize="21sp" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search or enter website"
                android:textColor="#FFFFFF"
                android:textColorHint="#7E8A9D"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/goButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="#E91E4D"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:contentDescription="Go" />

    </LinearLayout>


    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />


    <!-- MAIN -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME -->

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="15dp"
                android:paddingBottom="18dp">

               <!-- =========================================================
     WEBSITE CATEGORIES
     ========================================================= -->

<LinearLayout
    android:id="@+id/categoryContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- WATCH FOOTBALL / MOVIES -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WATCH FOOTBALL • LATEST MOVIES"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/liveCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/siteWatchFootball"
                android:layout_width="150dp"
                android:layout_height="110dp"
                android:layout_marginEnd="12dp"
                android:background="#151A22"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="#FF1744" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Watch Football"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/siteLatestMovies"
                android:layout_width="150dp"
                android:layout_height="110dp"
                android:background="#151A22"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:tint="#FF1744" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Latest Movies"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- SOCIAL & VIDEO -->

    <TextView
