            <TextView android:id="@+id/siteGuardian" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="The Guardian" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteNYTimes" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="New York Times" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteSkyNews" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Sky News" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteFrance24" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="France 24" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteDW" android:layout_width="130dp" android:layout_height="90dp" android:background="#151A22" android:gravity="center" android:text="DW" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- SCHOLARSHIPS & SPONSORSHIPS -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCHOLARSHIPS &amp; SPONSORSHIPS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/scholarshipCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView android:id="@+id/siteChevening" android:layout_width="150dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Chevening" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteErasmus" android:layout_width="150dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Erasmus Mundus" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteDAAD" android:layout_width="150dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="DAAD" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
