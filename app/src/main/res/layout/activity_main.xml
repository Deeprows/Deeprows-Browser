<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#6B5878"
    android:fitsSystemWindows="true">

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#6B5878"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#6B5878">

                <GridLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="18dp"
                    android:background="#6B5878">

                    <!-- DEEPROWSS HEADER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="start"
                        android:paddingStart="5dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="7dp">

                        <TextView
                            android:id="@+id/brandTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEEPROWSS"
                            android:textColor="#FF5C7C"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:gravity="start"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/brandTagline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Your Web. Your World."
                            android:textColor="#C9C1CC"
                            android:textSize="9sp"
                            android:letterSpacing="0.04"
                            android:gravity="start"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                    <!-- SEARCH BAR -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_home_card"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="⌕"
                            android:textColor="#BDB7C1"
                            android:textSize="22sp" />

                        <EditText
                            android:id="@+id/addressBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Search or enter website"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#B0AAB4"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:imeOptions="actionGo"
                            android:paddingStart="2dp"
                            android:paddingEnd="5dp" />

                        <ImageButton
                            android:id="@+id/goButton"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_media_play"
                            android:tint="#FFFFFF"
                            android:contentDescription="Go"
                            android:padding="10dp" />

                    </LinearLayout>

                <!-- =========================================================
     DYNAMIC SITE CATEGORIES
     ========================================================= -->

<LinearLayout
    android:id="@+id/siteCategoriesContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp" />

<!-- =========================================================
     LATEST NEWS
     ========================================================= -->

                    <!-- =========================================================
                         LATEST NEWS
                         ========================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_section"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Latest News"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:paddingStart="2dp"
                            android:paddingBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/newsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading latest news..."
                                android:textColor="#B7AFBC"
                                android:textSize="12sp"
                                android:padding="8dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/moreNewsButton"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="More News  →"
                            android:textColor="#FF6B8A"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- =========================================================
                         SPORT NEWS
                         ========================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_section"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sport News"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:paddingStart="2dp"
                            android:paddingBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/sportNewsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading sport news..."
                                android:textColor="#B7AFBC"
                                android:textSize="12sp"
                                android:padding="8dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/moreSportNewsButton"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="More Sport News  →"
                            android:textColor="#FF6B8A"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- =========================================================
                         GOOGLE TRENDS
                         ========================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_home_section"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🔥 Google Trends"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trendsLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Worldwide"
                                android:textColor="#BDB7C1"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="What's trending right now"
                            android:textColor="#AFA8B2"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/trendsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/moreTrendsButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="View Google Trends"
                            android:textColor="#FF6B8A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </GridLayout>

            </FrameLayout>

        </ScrollView>

        <!-- WEBVIEW -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#111B2D" />

        <!-- SETTINGS -->

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#6B5878"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Customize your Deeprows Browser"
                    android:textColor="#E0D7E6"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="8dp"
                    android:background="#29272D">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Data Saving"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reduce images and page data"
                            android:textColor="#B7AFBC"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/dataSavingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF5C7C" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="8dp"
                    android:background="#29272D">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ad Blocking"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Block common advertising requests"
                            android:textColor="#B7AFBC"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/adBlockingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF5C7C" />

                </LinearLayout>

                <TextView
                    android:id="@+id/historyButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="🕘   History"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#29272D"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/bookmarksButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="★   Bookmarks"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#29272D"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/offlinePagesButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="↓   Offline Pages"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#29272D"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/clearCacheButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="♻   Clear Cache"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#29272D"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/themeButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="#29272D"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🎨  Theme"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/downloadsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#29272D"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="📥  Downloads"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#29272D"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🔗  Share"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/translateButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#29272D"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🌐  Translate"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/settingsBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="17dp"
                    android:gravity="center"
                    android:text="← Back to Browser"
                    android:textColor="#FF6B8A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#29272D"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#25242A"
        android:elevation="10dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_back"
                android:tint="#E5E0E8"
                android:contentDescription="Back"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="#B8B1BB"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/forwardButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_forward"
                android:tint="#E5E0E8"
                android:contentDescription="Forward"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forward"
                android:textColor="#B8B1BB"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_home"
                android:tint="#FF5C7C"
                android:contentDescription="Home"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FF5C7C"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/refreshPageButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_refresh"
                android:tint="#E5E0E8"
                android:contentDescription="Refresh"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh"
                android:textColor="#B8B1BB"
                android:textSize="8sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/refreshButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_browser_tabs"
                    android:tint="#E5E0E8"
                    android:contentDescription="Open Pages"
                    android:padding="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tabs"
                    android:textColor="#B8B1BB"
                    android:textSize="8sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/pagesCount"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:layout_marginStart="17dp"
                android:layout_marginTop="-16dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="#FF1744" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/bookmarkButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_bookmark"
                android:tint="#E5E0E8"
                android:contentDescription="Bookmark"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#B8B1BB"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_menu"
                android:tint="#E5E0E8"
                android:contentDescription="Menu"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="#B8B1BB"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
