            <TextView android:id="@+id/siteIndeed" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Indeed" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteGlassdoor" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Glassdoor" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteZipRecruiter" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="ZipRecruiter" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteBayt" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Bayt" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteJooble" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Jooble" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteMonster" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Monster" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteJobStreet" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="JobStreet" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteWellfound" android:layout_width="130dp" android:layout_height="90dp" android:background="#151A22" android:gravity="center" android:text="Wellfound" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- SPORTS -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPORTS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/sportsCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView android:id="@+id/siteESPN" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="ESPN" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteBBCSport" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="BBC Sport" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteSkySports" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Sky Sports" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteGoal" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Goal" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteAthletic" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="The Athletic" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteCBSSports" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="CBS Sports" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteFoxSports" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="FOX Sports" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteSportingNews" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Sporting News" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteEurosport" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Eurosport" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteSportsIllustrated" android:layout_width="130dp" android:layout_height="90dp" android:background="#151A22" android:gravity="center" android:text="Sports Illustrated" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- NEWS -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEWS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/newsCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView android:id="@+id/siteBBCNews" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="BBC News" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteReuters" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Reuters" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/siteAP" android:layout_width="130dp" android:layout_height="90dp" android:layout_marginEnd="10dp" android:background="#151A22" android:gravity="center" android:text="Associated Press" android:textColor="#FFFFFF" android:textStyle="bold" android:clickable="true" android:focusable="true"/>
